#!/bin/sh
# Generated by .agents/harness/hooks/sync-settings.swift. Do not edit.
root="$(cd "$(dirname "$0")/.." && pwd)"
export CLAUDE_PROJECT_DIR="$(cd "$root/../.." && pwd)"
f="$root/hooks/sync-settings.swift"
bin="$root/.cache/bin/sync-settings"
if [ ! -x "$bin" ] || [ "$f" -nt "$bin" ]; then
    mkdir -p "$root/.cache/bin"
    if swiftc -Onone -gnone -o "$bin.$$" "$f" 2>/dev/null; then mv -f "$bin.$$" "$bin"
    else rm -f "$bin.$$"; exec swift "$f" "$@"; fi
fi
exec "$bin" "$@"
