#!/bin/sh
# Generated by .agents/harness/hooks/sync-settings.swift. Do not edit.
root="$(cd "$(dirname "$0")/.." && pwd)"
export CLAUDE_PROJECT_DIR="$(cd "$root/../.." && pwd)"
f="$root/hooks/guard-search.swift"
bin="$root/.cache/bin/guard-search"
in="$(mktemp)"; err="$(mktemp)"
trap 'rm -f "$in" "$err"' EXIT
cat > "$in"
if [ ! -x "$bin" ] || [ "$f" -nt "$bin" ]; then
    mkdir -p "$root/.cache/bin"
    if swiftc -Onone -gnone -o "$bin.$$" "$f" 2>/dev/null; then mv -f "$bin.$$" "$bin"
    else rm -f "$bin.$$" "$bin"; fi
fi
rc=1; out=""
if [ -x "$bin" ]; then
    out="$("$bin" "$@" < "$in" 2> "$err")"; rc=$?
fi
if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    rm -f "$bin"
    out="$(swift "$f" "$@" < "$in" 2> "$err")"; rc=$?
fi
if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
    [ -n "$out" ] && printf '%s\n' "$out"
    cat "$err" >&2; exit "$rc"
fi
msg="BLOCKED: hook guard-search failed to compile or crashed (exit $rc)"
if grep -q '"hookEventName"' "$in" 2>/dev/null; then
    printf '{"decision":"deny","reason":"%s"}\n' "$msg"
    exit 0
fi
cat "$err" >&2
printf '%s\n' "$msg" >&2
exit 2
