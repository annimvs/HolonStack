#!/bin/sh
# Generated by .agents/harness/hooks/sync-settings.swift. Do not edit.
root="$(cd "$(dirname "$0")/.." && pwd)"
export CLAUDE_PROJECT_DIR="$(cd "$root/../.." && pwd)"
f="$root/hooks/post-compact.swift"
bin="$root/.cache/bin/post-compact"
if [ ! -x "$bin" ] || [ "$f" -nt "$bin" ]; then
    mkdir -p "$root/.cache/bin"
    if swiftc -Onone -gnone -o "$bin.$$" "$f" 2>/dev/null; then mv -f "$bin.$$" "$bin"
    else rm -f "$bin.$$"; exec swift "$f" "$@"; fi
fi
in="$(mktemp)"; err="$(mktemp)"; cat > "$in"
out="$("$bin" "$@" < "$in" 2> "$err")"; rc=$?
if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
    [ -n "$out" ] && printf '%s\n' "$out"
    cat "$err" >&2; rm -f "$in" "$err"; exit "$rc"
fi
rm -f "$bin"
out="$(swift "$f" "$@" < "$in")"; rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
rm -f "$in" "$err"; exit "$rc"
